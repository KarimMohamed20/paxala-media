generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================
model User {
  id            String    @id @default(cuid())
  username      String    @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String
  image         String?
  role          Role      @default(CLIENT)
  managerId     String?
  manager       User?     @relation("UserManager", fields: [managerId], references: [id])
  managedUsers  User[]    @relation("UserManager")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  industry      String? // Company industry (for CLIENT role only)
  socialMedia   Json? // Social media accounts (for CLIENT role only)
  /// Staff job title shown on the Monthly Plan team strip ("Creative Director").
  /// Single column, so it is NOT localizable — see PlanTeamMember.roleLabel for
  /// the per-plan override. Null for CLIENT accounts.
  jobTitle      String?

  accounts         Account[]
  sessions         Session[]
  projects         Project[]         @relation("ClientProjects")
  assignedProjects Project[]         @relation("ProjectStaff")
  bookings         Booking[]
  comments         Comment[]
  assignedTasks    Task[]            @relation("AssignedTasks")
  approvedTasks    Task[]            @relation("ApprovedTasks")
  contacts         ClientContact[]   @relation("ClientContacts")
  leads            Lead[]            @relation("ClientLeads")
  contentPlans     ContentPlan[]
  contentReviews   ContentApproval[] @relation("ContentReviews")
  contentComments  ContentComment[]  @relation("ContentComments")
  folders          Folder[]          @relation("ClientFolders")

  planTeamships        PlanTeamMember[]    @relation("PlanTeamUser")
  planActionsCompleted PlanAction[]        @relation("PlanActionCompleter")
  planChangeRequests   PlanChangeRequest[] @relation("PlanChangeRequester")

  // ---- Playground ----
  playgroundRooms              PlaygroundRoom[]           @relation("PlaygroundRoomClient")
  playgroundRoomsCreated       PlaygroundRoom[]           @relation("PlaygroundRoomCreator")
  playgroundMemberships        PlaygroundMember[]         @relation("PlaygroundMemberships")
  playgroundNodes              PlaygroundNode[]           @relation("PlaygroundNodeAuthor")
  playgroundEvents             PlaygroundEvent[]          @relation("PlaygroundEventActor")
  playgroundComments           PlaygroundComment[]        @relation("PlaygroundComments")
  playgroundMessages           PlaygroundMessage[]        @relation("PlaygroundMessages")
  playgroundReactions          PlaygroundReaction[]       @relation("PlaygroundReactions")
  playgroundDecisions          PlaygroundDecision[]       @relation("PlaygroundDecisions")
  playgroundApprovalsRequested PlaygroundApproval[]       @relation("PlaygroundApprovalRequester")
  playgroundApprovalActions    PlaygroundApprovalAction[] @relation("PlaygroundApprovalResponder")
  playgroundFiles              PlaygroundFile[]           @relation("PlaygroundFileUploader")
  playgroundAiRuns             PlaygroundAiRun[]          @relation("PlaygroundAiRuns")
  playgroundSummaries          PlaygroundSummary[]        @relation("PlaygroundSummaryReviewer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ClientContact {
  id       String  @id @default(cuid())
  name     String
  phone    String
  jobTitle String?
  clientId String
  client   User    @relation("ClientContacts", fields: [clientId], references: [id], onDelete: Cascade)

  projects Project[] @relation("ProjectContacts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

// ==================== TEAM ====================
model TeamMember {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  nameHe    String
  roleEn    String
  roleAr    String
  roleHe    String
  bioEn     String?  @db.Text
  bioAr     String?  @db.Text
  bioHe     String?  @db.Text
  image     String?
  team      TeamType @default(PRODUCTION)
  order     Int      @default(0)
  skillsEn  String[] @default([])
  skillsAr  String[] @default([])
  skillsHe  String[] @default([])
  social    Json? // { instagram, linkedin, etc. }
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TeamType {
  PRODUCTION
  IT_DEV
  CREATIVE
}

// ==================== SERVICES ====================
model Service {
  id            String    @id @default(cuid())
  nameEn        String
  nameAr        String
  nameHe        String
  slug          String    @unique
  descriptionEn String    @db.Text
  descriptionAr String    @db.Text
  descriptionHe String    @db.Text
  icon          String?
  image         String?
  featuresEn    String[]  @default([])
  featuresAr    String[]  @default([])
  featuresHe    String[]  @default([])
  order         Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]
}

// ==================== PORTFOLIO ====================
model Portfolio {
  id            String            @id @default(cuid())
  titleEn       String
  titleAr       String
  titleHe       String
  slug          String            @unique
  descriptionEn String            @db.Text
  descriptionAr String            @db.Text
  descriptionHe String            @db.Text
  contentEn     String?           @db.Text
  contentAr     String?           @db.Text
  contentHe     String?           @db.Text
  thumbnail     String?
  images        String[]          @default([])
  videoUrl      String?
  category      PortfolioCategory
  tagsEn        String[]          @default([])
  tagsAr        String[]          @default([])
  tagsHe        String[]          @default([])
  clientName    String?
  featured      Boolean           @default(false)
  published     Boolean           @default(false)
  publishedAt   DateTime?
  order         Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

enum PortfolioCategory {
  VIDEO_PRODUCTION
  PHOTOGRAPHY
  GRAPHIC_DESIGN
  WEB_DEVELOPMENT
  APP_DEVELOPMENT
  THREE_D_MODELING
  ANIMATION
  SOCIAL_MEDIA
}

// ==================== PROJECTS ====================
model Project {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String          @db.Text
  content     String?         @db.Text
  thumbnail   String?
  images      String[]        @default([])
  videoUrl    String?
  category    ProjectCategory
  tags        String[]        @default([])
  clientName  String?
  clientId    String?
  client      User?           @relation("ClientProjects", fields: [clientId], references: [id])
  serviceId   String?
  service     Service?        @relation(fields: [serviceId], references: [id])
  staff       User[]          @relation("ProjectStaff")
  status      ProjectStatus   @default(IN_PROGRESS)
  featured    Boolean         @default(false)
  publishedAt DateTime?
  startDate   DateTime?
  endDate     DateTime?
  deadline    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  files        ProjectFile[]
  folders      Folder[]
  comments     Comment[]
  milestones   Milestone[]
  invoices     Invoice[]
  contacts     ClientContact[] @relation("ProjectContacts")
  lead         Lead?           @relation("LeadProject")
  contentPlans ContentPlan[]
  contentItems ContentItem[]

  playgroundRooms PlaygroundRoom[]
}

model Folder {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  color       String? @default("red")
  isShared    Boolean @default(false)

  /// Which client's library this folder belongs to. Null means agency-wide —
  /// the shipped defaults (Brand Identity, Photography…) that every client sees.
  /// Set whenever a CLIENT creates a folder, so one client's folder names never
  /// surface in another client's Asset Library. Visibility rule lives in
  /// folderVisibilityWhere() in src/lib/asset-scope.ts.
  /// SetNull, not Cascade: deleting a user must not delete their folders (the
  /// files inside belong to projects, which outlive the user account).
  clientId String?
  client   User?   @relation("ClientFolders", fields: [clientId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files     ProjectFile[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([projectId])
  @@index([clientId])
}

model ProjectFile {
  id                String             @id @default(cuid())
  name              String
  url               String
  type              String             @default("link") // link, video, image, document, etc.
  size              Float? // Size in bytes (Float supports > 2GB)
  description       String?            @db.Text
  category          String?            @default("Video") // Video, Photography, Design, Brand Files, Web & Digital, Documents
  folder            String?            @default("General") // Brand Identity, Campaigns 2026, Video Masters, Photography, Website & Digital, Documents
  folderId          String?
  folderRef         Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  version           String?            @default("V1 Final")
  status            String?            @default("Approved") // Approved Final, Approved, Shared, New, Final
  duration          String?
  thumbnail         String?
  uploader          String?            @default("PMP Creative Team")
  resolution        String?            @default("4K MP4")
  usageRights       String?            @default("Approved for web and social.")
  formats           Json? // Array of available format objects [{ name, resolution, size }]
  versionHistory    Json? // Array of version history objects [{ version, date, status }]
  isShared          Boolean            @default(false)
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId            String? // Optional: attach to specific task
  task              Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  contentItemAssets ContentItemAsset[]
  contentComments   ContentComment[]   @relation("ContentCommentAsset")

  playgroundNodes PlaygroundNode[] @relation("PlaygroundNodeAsset")
  playgroundFiles PlaygroundFile[] @relation("PlaygroundFilePromotion")

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([taskId])
  @@index([category])
  @@index([folder])
  @@index([folderId])
}

enum ProjectCategory {
  VIDEO_PRODUCTION
  PHOTOGRAPHY
  GRAPHIC_DESIGN
  WEB_DEVELOPMENT
  APP_DEVELOPMENT
  THREE_D_MODELING
  ANIMATION
  SOCIAL_MEDIA
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETED
  ARCHIVED
}

// ==================== LEADS ====================
enum LeadSource {
  WEBSITE
  INSTAGRAM
  REFERRAL
  WHATSAPP
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
}

model Lead {
  id                 String     @id @default(cuid())
  clientName         String
  company            String?
  email              String
  phone              String?
  source             LeadSource @default(WEBSITE)
  interestedIn       String?
  stage              LeadStage  @default(NEW)
  expectedValue      Decimal?   @db.Decimal(10, 2)
  currency           String     @default("ILS")
  nextFollowUpAt     DateTime?
  notes              String?    @db.Text
  lostReason         String?
  clientId           String?
  client             User?      @relation("ClientLeads", fields: [clientId], references: [id])
  convertedProjectId String?    @unique
  convertedProject   Project?   @relation("LeadProject", fields: [convertedProjectId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([stage])
  @@index([email])
  @@index([nextFollowUpAt])
}

// ==================== BOOKINGS ====================
model Booking {
  id          String        @id @default(cuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  name        String
  email       String
  phone       String?
  serviceType String
  packageId   String? // Optional package selection (e.g., "package-01", "package-02", "package-03")
  date        DateTime
  timeSlot    String
  duration    Int           @default(60) // minutes
  notes       String?       @db.Text
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ==================== BLOG ====================
model BlogPost {
  id          String       @id @default(cuid())
  titleEn     String
  titleAr     String
  titleHe     String
  slug        String       @unique
  excerptEn   String       @db.Text
  excerptAr   String       @db.Text
  excerptHe   String       @db.Text
  contentEn   String       @db.Text
  contentAr   String       @db.Text
  contentHe   String       @db.Text
  coverImage  String?
  authorId    String
  category    BlogCategory
  tagsEn      String[]     @default([])
  tagsAr      String[]     @default([])
  tagsHe      String[]     @default([])
  published   Boolean      @default(false)
  publishedAt DateTime?
  views       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum BlogCategory {
  NEWS
  TUTORIALS
  BEHIND_THE_SCENES
  CASE_STUDIES
  INDUSTRY_INSIGHTS
}

// ==================== COMMENTS ====================
model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== CLIENTS ====================
model ClientLogo {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  nameHe    String
  logo      String
  website   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ==================== CONTACT/INQUIRIES ====================
model ContactInquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
}

enum InquiryStatus {
  NEW
  READ
  RESPONDED
  ARCHIVED
}

// ==================== SITE SETTINGS ====================
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string") // string, json, boolean, number
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

